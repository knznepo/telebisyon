<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.knz.nekplik" android:versionCode="1" android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    <!-- Reading the movies on a USB drive or hard disk. nekplik.sh gives these over adb: TVs have no
         screen to ask for "All files access" (Android 11+), which the info.json and .srt files need. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Computers sharing their movies with share.py: found with a broadcast on the Wi-Fi, and played
         from over plain http (it's the home network; usesCleartextTraffic below). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets Telebisyon's web page list the library (same signing key only). Telebisyon declares it too,
         so it doesn't matter which of the two is installed first. -->
    <permission android:name="com.knz.nekplik.permission.LIBRARY" android:protectionLevel="signature" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="NEKPLIK" android:allowBackup="false" android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/banner" android:icon="@drawable/icon"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DetailsActivity" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <activity android:name=".SearchActivity" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <activity android:name=".PlayerActivity" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <provider android:name=".LibraryProvider" android:authorities="com.knz.nekplik.library"
            android:exported="true" android:permission="com.knz.nekplik.permission.LIBRARY" />
    </application>
</manifest>
